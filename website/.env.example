# Copy to .env and adjust. Only VITE_* variables reach the browser -- never
# put a secret in this file; everything here ships in the bundle.

# Where the API lives. Leave as /api/v1 to use the dev-server proxy, which
# keeps the SPA and the API same-origin so session cookies work without CORS.
VITE_API_BASE_URL=/api/v1

# The Django origin the dev-server proxy forwards /api to.
VITE_API_PROXY_TARGET=http://localhost:8000

# Billing. Keep in step with STRIPE_ENABLED on the backend.
VITE_STRIPE_ENABLED=false
VITE_STRIPE_PUBLISHABLE_KEY=

# Teams. Must match ORGANIZATIONS_ENABLED on the backend -- out of step, the
# organization pages render and then 404 against the API.
VITE_ORGANIZATIONS_ENABLED=false

# Social login. Must match SOCIAL_AUTH_ENABLED on the backend.
VITE_SOCIAL_AUTH_ENABLED=false

# Each must match its backend flag. Out of step, the UI renders and then
# 404s against the API.
VITE_TWO_FACTOR_ENABLED=false
VITE_API_KEYS_ENABLED=false
VITE_UPLOADS_ENABLED=false
VITE_AUDIT_LOG_ENABLED=false
