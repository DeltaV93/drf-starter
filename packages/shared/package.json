{
  "name": "@app/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Code the website and the mobile app both depend on: brand tokens, backend routes, API types and the response envelope.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./routes": "./src/routes.ts",
    "./types": "./src/types.ts",
    "./api": "./src/api.ts",
    "./locales/en.json": "./src/locales/en.json",
    "./locales/es.json": "./src/locales/es.json",
    "./passwordValidation": "./src/passwordValidation.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "axios": ">=1.9",
    "react": ">=19",
    "react-i18next": ">=15"
  }
}
