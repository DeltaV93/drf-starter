# Copy to .env and adjust. Only EXPO_PUBLIC_* variables reach the app -- never
# put a secret in this file; everything here ships in the bundle, and a mobile
# bundle is on a device its owner controls.

# Where the API lives. Unlike the website there is no dev-server proxy and no
# same-origin default: a phone or simulator is not the machine Django is
# running on, so this always has to be a real, reachable URL.
#
#   iOS simulator        http://localhost:8000/api/v1
#   Android emulator     http://10.0.2.2:8000/api/v1
#   a physical device    http://<your LAN address>:8000/api/v1
#
# Must NOT end with a slash.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Each must match its backend flag. Out of step, a screen renders and then
# 404s against the API -- exactly as on the website.
EXPO_PUBLIC_STRIPE_ENABLED=false
EXPO_PUBLIC_ORGANIZATIONS_ENABLED=false
EXPO_PUBLIC_TWO_FACTOR_ENABLED=false
EXPO_PUBLIC_API_KEYS_ENABLED=false
EXPO_PUBLIC_UPLOADS_ENABLED=false
EXPO_PUBLIC_AUDIT_LOG_ENABLED=false
EXPO_PUBLIC_SOCIAL_AUTH_ENABLED=false
EXPO_PUBLIC_MCP_CLIENT_ENABLED=false

# Device registration for push notifications. Must match PUSH_ENABLED.
EXPO_PUBLIC_PUSH_ENABLED=false

# Where "Manage your subscription" sends people. Billing is read-only in the
# app on purpose -- see docs/mobile.md.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Crash reporting
#
# A DSN is designed to ship inside a client, so it is not a secret and belongs
# here rather than in a build secret. Unset, nothing initialises and nothing
# is sent.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SENTRY_DSN=

# Ships usernames, email addresses and IP addresses to a third party. Off by
# default: turn it on once that is written down somewhere your users can read.
# EXPO_PUBLIC_SENTRY_SEND_PII=false

# Performance tracing costs battery and bandwidth on every session.
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Which build a report came from. EAS sets this; locally it is absent.
# EXPO_PUBLIC_SENTRY_RELEASE=
